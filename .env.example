# Supabase — Récupérer ces valeurs dans le dashboard Supabase
# Projet > Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CAPTCHA Cloudflare Turnstile — clé de SITE (publique), dash.cloudflare.com → Turnstile.
# La clé secrète va uniquement dans Supabase (Authentication → Attack Protection).
# Vide = pas de widget (à laisser vide tant que le CAPTCHA n'est pas activé dans Supabase).
# Clé de test Cloudflare (valide toujours) : 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Import stellaires — service_role bypasse RLS (ne jamais exposer côté client)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sauvegarde DB (scripts/backup-db.sh, npm run backup:db)
# Récupérer le mot de passe : Dashboard Supabase → Project Settings → Database
# SUPABASE_DB_PASSWORD=xxx
# OU URL complète (mot de passe percent-encodé si caractères spéciaux) :
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
