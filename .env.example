# Supabase — Récupérer ces valeurs dans le dashboard Supabase
# Projet > Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Import stellaires — service_role bypasse RLS (ne jamais exposer côté client)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sauvegarde DB (scripts/backup-db.sh, npm run backup:db)
# Récupérer le mot de passe : Dashboard Supabase → Project Settings → Database
# SUPABASE_DB_PASSWORD=xxx
# OU URL complète (mot de passe percent-encodé si caractères spéciaux) :
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Transit — échelle de temps joueur (optionnel)
# 1           → Proxima ≈ 1h joueur (valeur "réelle" des docs)
# 0.00138889 → Proxima ≈ 5s joueur (mode test : 5/3600)
VITE_TRANSIT_TIME_SCALE=0.00138889
