{
  "name": "lacuna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:devtools": "VUE_DEVTOOLS=true vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generate": "node scripts/generateExtendedSeed.js > supabase/seed_extended_systems.sql",
    "import:stellar": "cd stellar_import && python main.py",
    "backup:db": "./scripts/backup-db.sh",
    "dump:critiques": "bash scripts/pg_dump_critiques.sh"
  },
  "dependencies": {
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "^2.0.1",
    "d3": "^7.9.0",
    "pinia": "^3.0.4",
    "three": "^0.183.2",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "@vercel/analytics": {
      "vue-router": "$vue-router"
    }
  }
}
